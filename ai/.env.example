# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN pernah commit file .env yang sudah terisi.

# API key dari Alibaba Cloud Model Studio (bailian.console.aliyun.com)
# Settings > API Key > Create API Key, pilih workspace default.
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Endpoint region. Singapore/internasional (default):
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Untuk region China Beijing gunakan:
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Snapshot model bertanggal, bukan alias generik "qwen-plus".
QWEN_MODEL=qwen-plus-2025-07-28
