# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN pernah commit file .env yang sudah terisi.

# API key dari Alibaba Cloud Model Studio (bailian.console.aliyun.com)
# Settings > API Key > Create API Key, pilih workspace default.
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Endpoint region. Singapore/internasional (default):
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Untuk region China Beijing gunakan:
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Snapshot model bertanggal, bukan alias generik "qwen-plus".
QWEN_MODEL=qwen-plus-2025-07-28

# --- Model pembanding (hanya dipakai eval/uji_ai.py --profil llama|gpt) ---
# Semua lewat API kompatibel OpenAI. Isi versi model yang dipakai di skripsi.
# LLAMA_API_KEY=sk-or-xxxxxxxx
# LLAMA_BASE_URL=https://openrouter.ai/api/v1
# LLAMA_MODEL=<nama-model-llama>
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=<nama-model-gpt, mis. gpt-6-luna>
# OPENAI_REASONING_EFFORT=none   # bawaan untuk profil gpt; kosongkan untuk model non-reasoning lama

# --- Jalur OpenRouter (eval/uji_ai.py --profil <qwen|llama|gpt> --jalur openrouter) ---
# Ketiga model lewat satu gateway. Slug model dan nama provider: lihat halaman model di
# openrouter.ai (tab Providers). Hasil ke eval/hasil/openrouter/<profil>.
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OR_QWEN_MODEL=qwen/qwen3.8-flash
# OR_QWEN_PROVIDER=Alibaba
# OR_QWEN_REASONING=off          # off = {"enabled": false}, setara enable_thinking=False
# OR_LLAMA_MODEL=meta-llama/llama-4-scout
# OR_LLAMA_PROVIDER=<satu provider, mis. yang presisinya bf16/fp8 tercantum>
# OR_LLAMA_REASONING=-           # - = tidak dikirim (Llama 4 bukan model reasoning)
# OR_GPT_MODEL=openai/gpt-6-luna
# OR_GPT_PROVIDER=OpenAI
# OR_GPT_REASONING=none          # {"effort": "none"}, setara reasoning_effort=none

# Mode offline Hugging Face: auto (default) = offline bila model embedding sudah di cache.
# Isi 0 untuk selalu cek ke huggingface.co, 1 untuk memaksa offline.
# SADEWA_HF_OFFLINE=auto
