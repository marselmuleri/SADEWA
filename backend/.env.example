# ==============================================================================
# SADEWA Backend Environment Configuration Example
# Salin file ini ke .env di folder backend/ lalu sesuaikan nilainya.
# ==============================================================================

# Basis Data (Wajib PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sadewa

# Keamanan & JWT
SECRET_KEY=ganti-dengan-secret-key-yang-sangat-rahasia-dan-panjang-min-32-karakter
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Integrasi AI Service (Port 8001)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_SECONDS=60
OPENAI_API_KEY=your-openai-api-key-here

# Penyimpanan berkas Portofolio (RPS & lampiran). Default: backend/uploads
# UPLOAD_DIR=/path/ke/folder/uploads
# UPLOAD_MAX_MB=10
# NAMA_INSTITUSI=Universitas Diponegoro
